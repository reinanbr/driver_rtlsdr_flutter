+int rtlsdr_open(rtlsdr_dev_t **out_dev, uint32_t index)
+{
+	int r;
+	int i;
+	libusb_device **list;
+	rtlsdr_dev_t *dev = NULL;
+	libusb_device *device = NULL;
+	uint32_t device_count = 0;
+	struct libusb_device_descriptor dd;
+	ssize_t cnt;
+
+#if LOG_API_CALLS
+	fprintf(stderr, "LOG: rtlsdr_open(%u)\n", (unsigned)index);
+#endif
+
+#ifdef _ENABLE_RPC
+	if (rtlsdr_rpc_is_enabled())
+	{
+	  return rtlsdr_rpc_open((void**)out_dev, index);
+	}
+#endif
+
+	dev = rtlsdr_open_alloc_dev();
+	if (NULL == dev)
+		return -ENOMEM;
+
+	r = libusb_init(&dev->ctx);
+	if (r < 0) {
+		free(dev);
+		return -1;
+	}
+
+	dev->dev_num = index;
+	dev->dev_lost = 1;
+
+	cnt = libusb_get_device_list(dev->ctx, &list);
+
+	for (i = 0; i < cnt; i++) {
+		device = list[i];
+
+		libusb_get_device_descriptor(list[i], &dd);
+
+		if (find_known_device(dd.idVendor, dd.idProduct)) {
+			device_count++;
+		}
+
+		if (index == device_count - 1)
+			break;
+
+		device = NULL;
+	}
+
+	if (!device) {
+		libusb_free_device_list(list, 1);
+		libusb_exit(dev->ctx);
+		free(dev);
+		return -1;
+	}
+
+	r = libusb_open(device, &dev->devh);
+	if (r < 0) {
+		libusb_free_device_list(list, 1);
+		fprintf(stderr, "usb_open error %d\n", r);
+		if(r == LIBUSB_ERROR_ACCESS)
+			fprintf(stderr, "Please fix the device permissions, e.g. "
+			"by installing the udev rules file rtl-sdr.rules\n");
+		libusb_exit(dev->ctx);
+		free(dev);
+		return r;
+	}
+
+	libusb_free_device_list(list, 1);
+
+	return rtlsdr_open_finish(out_dev, dev, /*skip_kernel_driver_check=*/0);
+}
+
+/* Android: open using a libusb_device_handle already obtained via
+ * libusb_wrap_sys_device() over a file descriptor that Android's
+ * UsbManager/UsbDeviceConnection (Java) opened and granted permission for.
+ * Skips libusb device enumeration entirely, which requires access to
+ * /dev/bus/usb and is unavailable on unrooted Android — this is the
+ * pattern documented in libusb's own android/README. */
+RTLSDR_API int rtlsdr_open_fd(rtlsdr_dev_t **out_dev, libusb_context *ctx, libusb_device_handle *devh)
+{
+	rtlsdr_dev_t *dev = NULL;
+
+	if (!ctx || !devh || !out_dev)
+		return -EINVAL;
+
+	dev = rtlsdr_open_alloc_dev();
+	if (NULL == dev)
+		return -ENOMEM;
+
+	dev->ctx = ctx;
+	dev->devh = devh;
+	dev->dev_num = 0;
+	dev->dev_lost = 1;
+
+	return rtlsdr_open_finish(out_dev, dev, /*skip_kernel_driver_check=*/1);
+}
