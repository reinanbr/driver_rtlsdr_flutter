<?xml version="1.0" encoding="utf-8"?>
<!--
  List of VID/PID for known RTL-SDR dongles.

  Android's vendor-id/product-id attributes are DECIMAL, not hex — hence the
  hex comment next to each entry. This file only controls the app's
  auto-launch when the dongle is plugged in (via USB_DEVICE_ATTACHED); manual
  detection (UsbManager.getDeviceList() in UsbBridge.kt) sees any connected
  USB device regardless of this list.

  This is an initial list with the most common IDs (Realtek RTL2832U chip);
  most rebranded dongles (NooElec, RTL-SDR Blog, etc.) keep Realtek's
  default VID/PID. CONFIRM and adjust with the user's dongle's actual
  VID/PID once tested (Milestone 1) via the app's debug screen or
  `adb shell dumpsys usb`.
-->
<resources>
    <usb-device vendor-id="3034" product-id="10290" /> <!-- 0x0bda:0x2832 - RTL2832U (bare) -->
    <usb-device vendor-id="3034" product-id="10296" /> <!-- 0x0bda:0x2838 - RTL2832U + R820T (most common) -->
    <usb-device vendor-id="3034" product-id="10305" /> <!-- 0x0bda:0x2841 - common rebrand -->
</resources>
